DB_HOST=localhost
DB_PORT=5436
POSTGRES_DB=bingyx
POSTGRES_USER=bingyx
POSTGRES_PASSWORD=bingyx

HTTP_HOST=127.0.0.1
HTTP_PORT=8097

KEYCLOAK_ISSUER_URI=http://localhost:8098/auth/realms/bingyx
# Only when the keys are not reachable at the issuer, e.g. from inside a container.
# KEYCLOAK_JWKS_URI=http://keycloak:8080/auth/realms/bingyx/protocol/openid-connect/certs

BINGYX_CORS_ORIGINS=http://localhost:4203

# At least 32 characters; production must set its own.
PLAYER_TOKEN_SECRET=local-dev-player-token-secret-not-for-prod
PLAYER_TOKEN_TTL=14d

# Invitations by email stay off until there is a domain to send from.
FEATURE_EMAIL_INVITES=false

LOG_LEVEL=info
LOG_PRETTY=false

